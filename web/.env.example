# Supabase — preencha quando o projeto "protecaorr-sstapp" estiver criado
# (Project Settings → API). Nunca comitar o arquivo .env.local real.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Chave de service_role — SOMENTE no servidor (nunca exposta ao navegador).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
